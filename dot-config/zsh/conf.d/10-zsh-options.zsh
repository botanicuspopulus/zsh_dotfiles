setopt NO_BEEP
setopt NO_HUP             # don't kill background jobs on exit
setopt NO_BG_NICE         # don't nice background tasks
setopt NO_IGNORE_EOF      # Don't exit on end of file

setopt NO_RM_STAR_SILENT  # Ask for confirmation before executing 'rm *'

REPORTTIME=10             # Print timing for commands that run longer than 10 seconds
